# Kopiere diese Datei zu ".env" und trage deine eigenen App-Zugangsdaten ein.
# Jede Plattform braucht eine eigene, bei dir registrierte App - siehe README.md
# fuer die genauen Schritte pro Plattform.

# Basis-URL, unter der dieses Tool erreichbar ist (fuer OAuth-Redirects).
# Fuer lokale Entwicklung reicht http://localhost:3000
APP_BASE_URL=http://localhost:3000
PORT=3000

# Zufaelliger, langer String zum Signieren der Session-Cookies
SESSION_SECRET=bitte-hier-einen-eigenen-zufallsstring-einsetzen

# --- LinkedIn (developer.linkedin.com) ---
# Produkte im LinkedIn-App-Dashboard aktivieren: "Sign In with LinkedIn using OpenID Connect".
# Fuer echte Post-Kennzahlen (Likes/Kommentare/Impressions) ist zusaetzlich das
# "Community Management API" bzw. "Marketing Developer Platform"-Produkt noetig,
# das LinkedIn erst nach Pruefung frei schaltet - siehe README, Abschnitt LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Instagram / Meta (developers.facebook.com) ---
# App vom Typ "Business" anlegen, Produkt "Instagram Graph API" hinzufuegen,
# dein eigenes Instagram-Business/Creator-Konto (verknuepft mit einer Facebook-Seite)
# im App-Dashboard unter "Rollen -> Tester" hinzufuegen.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- TikTok (developers.tiktok.com) ---
# App anlegen, Produkt "Login Kit" + "Display API" hinzufuegen,
# dein eigenes Konto unter "Sandbox -> Target Users" als Tester eintragen.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
